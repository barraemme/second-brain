{
  "name": "second-brain",
  "version": "0.1.0",
  "description": "The Second Brain: a knowledge base built from technical newsletters.",
  "private": true,
  "type": "module",
  "bin": {
    "kb-mcp": "kb/mcp/server.ts"
  },
  "scripts": {
    "start": "bun run migrate && bun --watch kb/main.ts",
    "migrate": "bun kb/db/migrate.ts",
    "mcp": "bun kb/mcp/server.ts",
    "lint": "biome check --error-on-warnings . && tsc --noEmit",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "bun run lint && bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mozilla/readability": "0.6.0",
    "hono": "4.13.19",
    "inngest": "4.26.2",
    "kysely": "0.29.9",
    "linkedom": "0.18.15",
    "neo4j-driver": "6.3.2",
    "openai": "7.62.0",
    "pg": "8.23.1",
    "robots-parser": "3.1.0",
    "rss-parser": "3.13.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
